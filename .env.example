APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legalcloud
DB_USERNAME=legalcloud
# Misma clave local del usuario creado en docs/backend.md. Cámbiala en los dos sitios.
DB_PASSWORD=elige-una-clave-local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync indexa el documento durante la carga. En producción usa database y un worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
LEGALCLOUD_API_MODE=api
LEGALCLOUD_API_TOKEN_TTL_DAYS=30

VECTOR_DB_ENABLED=false
VECTOR_DB_CONNECTION=vector
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_DATABASE=legalcloud_vectors
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=
VECTOR_DB_SSLMODE=prefer
VECTOR_EMBEDDING_DIMENSIONS=1536
VECTOR_EMBEDDING_MODEL=text-embedding-3-small

LEGALCLOUD_OCR_PROVIDER=native
LEGALCLOUD_EMBEDDINGS_ENABLED=false
LEGALCLOUD_EMBEDDINGS_PROVIDER=openai
LEGALCLOUD_LLM_ENABLED=false
LEGALCLOUD_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=900
